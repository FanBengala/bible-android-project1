<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight: тема сама следует за светлым/тёмным режимом телефона -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Бежевый, пока грузится веб-часть и показывается заставка; потом MainActivity ставит цвет по режиму -->
        <item name="android:windowBackground">@color/splash_beige</item>
    </style>

    <!-- Системная заставка Android: только цвет, иконка прозрачная.
         Полноэкранная картинка показывается сразу после неё в самом приложении (index.html) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_beige</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
